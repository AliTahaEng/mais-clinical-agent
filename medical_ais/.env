# ============================================================
# Medical Autonomous Intelligence System (MAIS)
# Environment Variables - Copy this file to .env and fill in
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: claude | gpt4o | azure
LLM_PROVIDER=azure

# Anthropic Claude (used for reasoning, synthesis, self-critique)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Cheaper/faster model for classification and routing
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# OpenAI GPT-4o (optional - used for entity extraction in pipeline)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ── Azure OpenAI (GPT-4) ──────────────────────────────────────
# Set LLM_PROVIDER=azure to use these
AZURE_OPENAI_ENDPOINT=https://optimusrcm.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=ddc8a85d76dd4b40a1b4cab60430b1b5
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_RESOURCE_NAME=optimusrcm


# ── Knowledge Graph (Neo4j) ───────────────────────────────────
# Start with: docker-compose up -d neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tpKnzIbSTPt6-1AX7AARWi2ZoC24RV_AE3q5XPgOAbo

# ── Vector Store ──────────────────────────────────────────────
# Options: lancedb | pinecone
VECTOR_STORE_PROVIDER=lancedb
# LanceDB: local file-based (no extra service needed)
LANCEDB_PATH=./data/lancedb

# Pinecone (optional, for production scale)
PINECONE_API_KEY=pcsk_6HKhM6_9ys64r8rGKeD88ejmTh35DTavJrbtFshkfDRCrVktqmfkdUrVu5xYbsrHRQ2V7X
PINECONE_INDEX_NAME=medical-ais
PINECONE_ENVIRONMENT=us-east-1

# ── BM25 Search ───────────────────────────────────────────────
# Options: bm25_local (no service) | elasticsearch
SEARCH_PROVIDER=bm25_local
# Elasticsearch (optional, for production)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=medical_chunks

# ── PostgreSQL (Audit Trail + LangGraph Checkpoints) ─────────
# Start with: docker-compose up -d postgres
POSTGRES_URL=postgresql+asyncpg://mais_user:alitaha123@localhost:5432/mais_db

# ── Redis (Cache + Rate Limiting + Idempotency) ───────────────
# Start with: docker-compose up -d redis
REDIS_URL=redis://localhost:6379/0

# ── EHR Integration ───────────────────────────────────────────
# Options: mock (for dev/testing) | fhir (real hospital EHR)
EHR_PROVIDER=mock

# FHIR R4 compliant EHR (Epic, Cerner, OpenMRS)
FHIR_SERVER_URL=https://your-hospital.fhir.com/r4
FHIR_API_KEY=your_fhir_bearer_token
FHIR_CLIENT_ID=your_client_id

# ── Web Search (Tavily) ───────────────────────────────────────
# Get API key at: https://tavily.com
# Used when CRAG escalates to web search for missing information
TAVILY_API_KEY=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

# ── Observability (LangSmith) ─────────────────────────────────
# Get API key at: https://smith.langchain.com
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=medical-ais
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── System Safety Thresholds ─────────────────────────────────
# Minimum confidence score before any autonomous action (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.80
# Maximum agent reasoning loop iterations (prevents infinite loops)
MAX_ITERATIONS=5
# Maximum knowledge graph traversal hops (prevents explosion)
MAX_HOPS=3
# Number of documents to retrieve per search
TOP_K_RETRIEVAL=10
# Tool execution timeout in seconds
TOOL_TIMEOUT_SECONDS=30

# ── API Security ──────────────────────────────────────────────
# Secret key for API authentication
API_SECRET_KEY=your-very-long-random-secret-key-here-minimum-32-chars
# JWT secret for token signing
JWT_SECRET=your-jwt-secret-minimum-32-characters
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Feature Flags ─────────────────────────────────────────────
# Set to false to disable autonomous action execution (safe default for dev)
ENABLE_ACTION_EXECUTION=false
# Set to true to require human approval for ALL actions (override tiers)
FORCE_HUMAN_APPROVAL=false
# Enable web search fallback when retrieval quality is bad
ENABLE_WEB_SEARCH=true
# Enable LangSmith tracing (disable for cost savings)
ENABLE_TRACING=true

# ── Pipeline Configuration ────────────────────────────────────
# Directory for medical documents to ingest
DOCUMENTS_DIR=./data/documents
# Maximum chunk size (tokens) for parent chunks
PARENT_CHUNK_SIZE=1200
# Maximum chunk size (tokens) for child chunks
CHILD_CHUNK_SIZE=200
# Overlap between child chunks (tokens)
CHUNK_OVERLAP=50

# ── Embedding Model ───────────────────────────────────────────
# Options: bgem3 (local, recommended) | openai
EMBEDDING_PROVIDER=bgem3
EMBEDDING_MODEL=BAAI/bge-m3
# OpenAI embeddings (optional fallback)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── Reranker ─────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Logging ───────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json
